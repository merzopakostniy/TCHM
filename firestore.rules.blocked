rules_version = '2';

// ПОЛНАЯ БЛОКИРОВКА ДОСТУПА.
// Данные в базе не тронуты — закрыт только доступ из приложения.
// Firebase Console и Admin SDK правила не проверяют, свой доступ ты сохраняешь.
// Откат: git checkout firestore.rules && firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
