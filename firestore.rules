rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile() && userDoc().data.role is string
        ? userDoc().data.role
        : 'viewer';
    }

    function isDeveloperUser() {
      return role() == 'developer';
    }

    function isManagementUser() {
      return role() in ['admin', 'developer'];
    }

    // Старые профили без статуса или депо не дают доступа. Пользователи
    // регистрируются заново через Yandex API, включая прежние привилегированные роли.
    function activeProfile() {
      return hasProfile() && userDoc().data.get('status', null) == 'active' &&
        userDoc().data.get('depotId', null) is string &&
        userDoc().data.depotId.size() > 0;
    }

    function safeStatusChange(userId) {
      return isManagementUser() && activeProfile() &&
        request.auth.uid != userId &&
        (isDeveloperUser() || resource.data.role != 'developer') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['active', 'disabled'];
    }

    // ---- Режим обслуживания -------------------------------------------
    // Флаг лежит в config/app и переключается кнопкой из аккаунта
    // разработчика. Отсутствие документа = обычный режим, поэтому правила
    // можно деплоить до того, как флаг создан.
    function lockDoc() {
      return get(/databases/$(database)/documents/config/app).data;
    }

    function lockExists() {
      return exists(/databases/$(database)/documents/config/app);
    }

    // Только просмотр: данные видны, изменения не сохраняются.
    function writesBlocked() {
      return lockExists() && lockDoc().writesBlocked == true;
    }

    // Полная блокировка: приложение не открывается ни у кого, кроме
    // разработчика — иначе снять блокировку из приложения будет нечем.
    function readsBlocked() {
      return lockExists() && lockDoc().readsBlocked == true;
    }

    function lockActive() {
      return writesBlocked() || readsBlocked();
    }

    function canRead() {
      return activeProfile() && (!readsBlocked() || isDeveloperUser());
    }

    function canWriteData() {
      return activeProfile() && !writesBlocked() && !readsBlocked();
    }

    function assignedColumnId() {
      return signedIn() ? userDoc().data.assignedColumnId : null;
    }

    // ---- Изоляция депо ------------------------------------------------
    // Депо вошедшего человека. Разработчик работает поверх всех депо,
    // поэтому для него проверка снимается — иначе он не сможет ни завести
    // новое депо, ни разобрать чужую поломку.
    function userDepot() {
      return hasProfile() ? userDoc().data.get('depotId', null) : null;
    }

    function sameDepot(data) {
      return isManagementUser() ||
        (data.depotId is string && data.depotId == userDepot());
    }

    function canEditAny() {
      return activeProfile() && role() in ['admin', 'tchm', 'operator', 'developer'];
    }

    function canEditColumn(columnId) {
      return canEditAny() ||
        (role() == 'instructor' && assignedColumnId() == columnId);
    }

    // Регистрация и назначение ролей перенесены на сервер Yandex Cloud.
    // Ни один клиент Firebase не может создать профиль или изменить его
    // роль, депо, табельный номер либо привязку к колонне. Для старых
    // профилей такие изменения доступны только доверенному Admin SDK.

    match /config/app {
      allow read: if true;
      allow write: if activeProfile() && isDeveloperUser();
    }

    match /users/{userId} {
      allow read: if canRead() || (signedIn() && request.auth.uid == userId);
      allow create: if false;
      allow update: if canWriteData() && (
        safeStatusChange(userId) ||
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']))
      );
      allow delete: if canWriteData() && isManagementUser()
        && request.auth.uid != userId
        && (isDeveloperUser() || resource.data.role != 'developer');
    }

    // Старый реестр больше не используется для клиентской выдачи ролей.
    match /roster/{entryId} {
      allow read: if canRead() && sameDepot(resource.data);
      allow write: if false;
    }

    // Запрос без фильтра по своему депо сервер отклонит целиком: правило
    // требует совпадения depotId, а Firestore пропускает только те выборки,
    // про которые может доказать, что чужого в них не будет.
    match /columns/{columnId} {
      // resource == null — это чтение документа, которого ещё нет. Так
      // приложение проверяет, свободен ли номер колонны, перед созданием;
      // без этой ветки правило падает на resource.data с Null value error.
      allow read: if canRead() && (resource == null || sameDepot(resource.data));
      allow create: if canEditAny() && canWriteData()
        && sameDepot(request.resource.data);
      allow update: if canEditAny() && canWriteData()
        && sameDepot(resource.data) && sameDepot(request.resource.data)
        && request.resource.data.depotId == resource.data.depotId;
      allow delete: if canEditAny() && canWriteData()
        && sameDepot(resource.data);
    }

    match /machinists/{machinistId} {
      allow read: if canRead() && (resource == null || sameDepot(resource.data));
      allow create: if canWriteData()
        && sameDepot(request.resource.data)
        && canEditColumn(request.resource.data.columnId)
        && request.resource.data.columnId is string;
      allow update: if canWriteData()
        && sameDepot(resource.data)
        && sameDepot(request.resource.data)
        && canEditColumn(resource.data.columnId)
        && request.resource.data.columnId == resource.data.columnId
        // Депо менять нельзя даже своему: иначе запись уедет в чужое депо.
        && request.resource.data.depotId == resource.data.depotId;
      allow delete: if canWriteData()
        && sameDepot(resource.data)
        && canEditColumn(resource.data.columnId);
    }
  }
}
